# tools/embed.awk: turns the harness runtime files into C arrays, so that
# liblc carries them and lc never has to find them on disk.
#
#   LC_ALL=C awk -f tools/embed.awk runtime/c/lc_prelude.h ... >rt_files.c
#
# Each file becomes a NUL-terminated array of byte values (not a string
# literal: ISO C only promises string literals of 4095 bytes) and an entry
# in lc_rt_files[], named by its path without the leading "runtime/". The
# files must be ASCII. POSIX awk only.

BEGIN {
    for (i = 1; i < 128; i++)
        ord[sprintf("%c", i)] = i
    print "/* Generated by tools/embed.awk from runtime/; do not edit. */"
    print "#include \"internal.h\""
    nfiles = 0
}

function emit(v) {
    if (col == 0)
        printf "   "
    printf " %d,", v
    col++
    if (col == 16) {
        printf "\n"
        col = 0
    }
}

function end_file() {
    emit(0)
    if (col != 0)
        printf "\n"
    print "};"
}

FNR == 1 {
    if (nfiles > 0)
        end_file()
    name[nfiles] = FILENAME
    sub(/^(\.\/)?runtime\//, "", name[nfiles])
    printf "\nstatic const char rt_%d[] = {\n", nfiles
    nfiles++
    col = 0
}

{
    line = $0
    n = length(line)
    for (i = 1; i <= n; i++) {
        c = substr(line, i, 1)
        if (!(c in ord)) {
            printf "embed.awk: %s:%d: not ASCII\n", FILENAME, FNR > "/dev/stderr"
            failed = 1
            exit 1
        }
        emit(ord[c])
    }
    emit(10)
}

END {
    if (failed)
        exit 1
    if (nfiles > 0)
        end_file()
    print ""
    print "const lc_rt_file lc_rt_files[] = {"
    for (i = 0; i < nfiles; i++)
        printf "    {\"%s\", rt_%d, sizeof rt_%d - 1},\n", name[i], i, i
    print "};"
    print ""
    print "const size_t lc_rt_nfiles = sizeof lc_rt_files / sizeof lc_rt_files[0];"
}
